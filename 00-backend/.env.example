# --- Database (use these DB_* names; they avoid clashes with host-provided USER/HOST/PORT) ---
DB_NAME=rental_crm
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306
DIALECT=mysql
# Set to true for cloud MySQL that requires TLS (Aiven, TiDB Cloud, ...)
DB_SSL=false

# --- Server ---
# Local only. On a hosting platform leave APP_PORT unset; the platform's PORT is used.
APP_PORT=5000
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Load demo data automatically when the database has no users (first deploy)
AUTO_SEED=false
